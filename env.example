# AI Child Health Environment Configuration
# Copy this file to .env and update the values as needed

# Application Environment
ENVIRONMENT=development
DEBUG=true
APP_NAME=AI Child Health
APP_VERSION=1.0.0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/child_health
DATABASE_TEST_URL=postgresql://postgres:password@localhost:5432/child_health_test

# Redis Configuration
REDIS_URL=redis://localhost:6379

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/jpg

# AI/ML Model Settings
MODEL_PATH=ml_models/malnutrition_detection.h5
CONFIDENCE_THRESHOLD=0.7

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email Settings (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# External APIs
WHO_API_URL=https://www.who.int/tools/child-growth-standards

# Localization
SUPPORTED_LANGUAGES=en,lg,ry,luo,sw
DEFAULT_LANGUAGE=en

# Monitoring
ENABLE_METRICS=true
PROMETHEUS_PORT=9090

# Development Settings
RELOAD=true
WORKERS=1
HOST=0.0.0.0
PORT=8000
